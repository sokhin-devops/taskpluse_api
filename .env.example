# ---------------------------------------------------------------------------
# TaskPulse API - production environment
#
# Copy to .env on the server, fill in the real values, and pass it to the
# container with `docker run --env-file .env`. .env itself is gitignored: these
# are the only credentials the deployment has.
# ---------------------------------------------------------------------------

SPRING_PROFILES_ACTIVE=prod

# Database. Use the container/service hostname, not localhost, when Postgres runs
# in a sibling container - inside the API container localhost is the API itself.
DB_URL=jdbc:postgresql://postgres:5432/taskpluse_db
DB_USERNAME=taskpulse
DB_PASSWORD=

# Signing key for issued tokens. At least 32 characters; HS256 needs 256 bits.
# Generate one with:  openssl rand -base64 48
# Changing it signs every existing user out, which is also how you revoke a leak.
APP_JWT_SECRET=

# Browser origins allowed to call /api/**. Comma-separated, scheme included, no
# trailing slash. Add a staging origin here rather than loosening it to "*".
APP_CORS_ALLOWED_ORIGINS=https://taskpluse-web.sokhin.site

# Optional overrides
# SERVER_PORT=8082
# APP_JWT_EXPIRATION_MINUTES=720
# SPRING_JPA_DDL_AUTO=update
# SPRINGDOC_ENABLED=true
