# Build output: the image compiles from source, and copying a host-built target/
# both bloats the context and risks shipping a jar that does not match src/.
target/

# Version control and IDE state
.git/
.gitignore
.gitattributes
.idea/
.vscode/
*.iml

# Local secrets must never reach the build context - anything copied in is
# recoverable from the image layers even if a later step deletes it.
.env
.env.*
!.env.example

HELP.md
